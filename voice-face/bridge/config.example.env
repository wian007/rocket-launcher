# Kopieer naar .env, vul in, en laad met:  set -a; . ./.env; set +a
ANTHROPIC_API_KEY=sk-ant-...

# Whisper-model: tiny/base (Raspberry Pi), small (pc, goed Nederlands), medium (pc met GPU)
WHISPER_MODEL=small

# Nederlandse Piper-stem (zie README voor downloaden)
PIPER_VOICE=voices/nl_NL-mls-medium.onnx

# Claude-model en denkniveau. low = snelste antwoord, geschikt voor praten.
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# HTTP-adres van de ESP32-CAM van de lanceerder. Leeg laten = richten wordt gesimuleerd.
LAUNCHER_URL=
